# Copy to .env for local development. Never commit .env.
DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Add your tunnel host here when testing on a phone, e.g. abc.trycloudflare.com
CSRF_TRUSTED_ORIGINS=

# Leave DATABASE_URL unset to use SQLite. On Render it is set for you.
# DATABASE_URL=postgres://...

# Email: unset EMAIL_HOST prints emails to the console.
# Gmail needs 2-step verification and an App Password (not your normal password).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=you@gmail.com

# Pitch demo (docs/pitch-demo.md)
# 공개 주소에서 아이폰이 POST(대여/반납)하려면 두 줄 모두 필요하다. CSRF_TRUSTED_ORIGINS는 https:// 를 붙인 전체 origin.
# ALLOWED_HOSTS=localhost,127.0.0.1,abc.trycloudflare.com
# CSRF_TRUSTED_ORIGINS=https://abc.trycloudflare.com
# 설정하면 /api/tag-read/ 와 /api/bridge-read/ 가 X-Device-Token 헤더를 요구한다 (시뮬레이터 버튼은 로그인 세션이라 상관없음).
# DEVICE_TOKEN=change-me-too
# 마지막 블루투스 신호가 이 초보다 오래되면 Disconnected. 시뮬레이터 하트비트 간격(초).
# BT_DISCONNECT_SECONDS=10
# BT_HEARTBEAT_SECONDS=3
# 시연: 이 MRN 환자에게 대여되면 아래 주소로 알림 메일을 보낸다 (SMTP 설정이 있어야 한다). 주소가 비어 있으면 안 보낸다.
# DEMO_NOTIFY_MRN=1003
# DEMO_NOTIFY_EMAIL=you@example.com
